{
  // ---------------------------------------------------------------------------
  // Weight-decay-exclusion ablation: same architecture as the production
  // KHOP run (configs/production/khop_200ep.json5), run as a single
  // un-segmented 60-epoch job (no resume/chaining). teacher_temp is reverted
  // to PRODUCTION's exact (inverted) values -- 0.07->0.01 -- since the
  // teacher-temp-direction ablation already showed that variable doesn't
  // affect the collapse either way. The only intentional difference from
  // production's own settings is the code-level fix in
  // training/dino_training.py (_split_decay_params): the optimizer now
  // excludes BatchNorm gamma/beta and all biases from weight decay, instead
  // of applying it uniformly to every parameter. Direct checkpoint
  // inspection showed BatchNorm gamma's RMS collapsing from ~0.97 to ~0.05
  // over 200 epochs under the old uniform-decay optimizer, which alone is
  // enough to explain the encoder_embedding_std collapse (BatchNorm output
  // variance is bounded by gamma^2). This run tests whether that fix alone
  // is sufficient to prevent the collapse.
  //
  // Launched via torchrun on 8 GPUs (run_weight_decay_test.sbatch).
  // batch_size is PER-RANK (128); with 8 ranks the global effective batch is
  // 1024, matching the production run's single-GPU batch_size=1024 exactly.
  // auto_scale_lr is disabled and learning_rate is set explicitly to what
  // auto_scale_lr would have computed for a global batch of 1024 in the
  // production config (lr_scale_base * 1024/256 = 0.000025).
  // ---------------------------------------------------------------------------
  name: "WEIGHT_DECAY_FIX_TEST_60EP",

  head_type: "dino",
  encoder_type: "GAT",
  global_pooling: "add",

  // ---------------------------------------------------------------------------
  // Data loading -- full 9M-shard production dataset, staged to scratch by
  // run_weight_decay_test.sbatch exactly like the production run does.
  // ---------------------------------------------------------------------------
  data_path: "data/zinc/zinc_9M_data",
  use_precomputed: true,
  precomputed_data_path: "/scratch/local/precomputed_9M_data_wdtest",
  cache_data_in_memory: false,
  precomputed_cache_in_memory: false,
  precomputed_max_cached_shards: 3,
  explicit_hydrogens: true,
  encode_hydrogen_count: false,

  // ---------------------------------------------------------------------------
  // Augmentation -- identical to production
  // ---------------------------------------------------------------------------
  local_views: 2,
  local_augmentation_mode: "functional_group_k_hop",
  k_hops: 2,
  node_mask_ratio: 0.05,
  feature_mask_ratio: 0,
  use_batched_mask_collate: true,

  // ---------------------------------------------------------------------------
  // Runtime and logging
  // ---------------------------------------------------------------------------
  seed: 1,
  device: "cuda",
  num_workers: 6,
  loader_debug: false,
  profile_timing: true,
  profile_log_every_n_batches: 200,

  // ---------------------------------------------------------------------------
  // Model dimensions -- identical to production (hidden_dim=1024)
  // ---------------------------------------------------------------------------
  num_features: 24,
  edge_features: 12,
  hidden_dim: 1024,
  num_layers: 3,
  dropout: 0.0,
  epsilon: 0.0,
  projection_hidden_dim: 1024,
  projection_bottleneck_dim: 1024,
  projection_output_dim: 1024,
  projection_layers: 2,

  // ---------------------------------------------------------------------------
  // Training and optimization
  // ---------------------------------------------------------------------------
  num_epochs: 60,

  // Per-GPU batch size. With 8 GPUs (DDP), global effective batch = 1024,
  // matching the production run's single-GPU batch_size=1024.
  batch_size: 128,

  // Explicit LR matching what auto_scale_lr computed for the production
  // run's global batch of 1024: lr_scale_base(0.00000625) * 1024/256 = 0.000025.
  auto_scale_lr: false,
  learning_rate: 0.000025,
  use_data_parallel: false,
  lr_scale_base: 0.00000625,
  lr_scale_reference_batch_size: 256,
  weight_decay: 0.04,
  weight_decay_start: 0.04,
  weight_decay_end: 0.2,

  // Reverted to production's exact (inverted) values -- already shown not to
  // be the cause of the collapse, kept as-is so this run isolates only the
  // weight-decay-group fix.
  teacher_temp: 0.07,
  teacher_temp_final: 0.01,
  teacher_temp_warmup_epochs: 20,

  student_temp: 0.1,
  teacher_momentum: 0.99,
  center_momentum: 0.9,
  sync_teacher_batchnorm_buffers: true,
  warmup_epochs: 20,
  final_learning_rate: 0.00001,

  validation_enabled: true,
  validation_split: 0.1,

  online_eval_enabled: true,
  online_eval_every_n_epochs: 1,
  online_eval_datasets: "lipo",
  online_eval_fixed_k: 21,
  online_eval_top_k_checkpoints: 5,
}
