{
  // ---------------------------------------------------------------------------
  // Masked-node reconstruction auxiliary loss, WITH a weight warmup -- follow-up
  // to NODE_RECON_TEST_60EP (flat weight=1.0 from epoch 1), which came back
  // worse than the no-node-loss baseline on the two apples-to-apples datasets
  // (LIPO: MLP R2 -0.031/-3 std, RF R2 -0.009; Tox21: MLP ROC-AUC -0.011, RF
  // ROC-AUC -0.014 -- small but consistent 4/4 in the same direction) while
  // node_recon_loss itself never settled cleanly in loss_history.json (bottomed
  // at epoch 10, partially reversed, drifted upward for the rest of training).
  //
  // Everything else identical to NODE_RECON_TEST_60EP / MIXED_GAT4HEADS_TEST_60EP
  // -- the only change is node_reconstruction_loss_warmup_epochs: 0 -> 15, so the
  // weight ramps linearly 0 -> 1.0 over the first 15 epochs instead of hitting
  // full strength on step 1. Rationale: mask_token/node_head start from random
  // init and have nothing useful to teach the encoder yet -- a full-strength,
  // high-variance, uninformed gradient from step 1 competing with the graph loss
  // (which is also starting from scratch) is a plausible explanation for both
  // the loss-curve instability and the worse downstream numbers. 15 epochs is
  // roughly the middle of the "~10-15 epochs" estimate discussed with the
  // supervisor-facing analysis, and shorter than warmup_epochs/
  // teacher_temp_warmup_epochs (20) so the node loss is fully phased in before
  // those other schedules finish their own transitions.
  //
  // New model, trained from scratch.
  // ---------------------------------------------------------------------------
  name: "NODE_RECON_WARMUP_TEST_60EP",

  head_type: "dino",
  encoder_type: "GAT",
  global_pooling: "add",

  // ---------------------------------------------------------------------------
  // Data loading -- original 24-feature production dataset, staged to its
  // own scratch path by run_node_recon_warmup_test.sbatch.
  // ---------------------------------------------------------------------------
  data_path: "data/zinc/zinc_9M_data",
  use_precomputed: true,
  precomputed_data_path: "/scratch/local/precomputed_9M_data_noderecontestwarmup",
  cache_data_in_memory: false,
  precomputed_cache_in_memory: false,
  precomputed_max_cached_shards: 3,
  explicit_hydrogens: true,
  encode_hydrogen_count: false,

  // ---------------------------------------------------------------------------
  // Augmentation -- mixed: view 0 = functional_group_k_hop (k_hops=2),
  // view 1 = functional_group_masking (node_mask_ratio=0.60) -- identical to
  // NODE_RECON_TEST_60EP / MIXED_GAT4HEADS_TEST_60EP. local_augmentation_mode
  // is set but unused/overridden by local_view_modes -- kept as a valid,
  // documented fallback value only.
  // ---------------------------------------------------------------------------
  local_views: 2,
  local_augmentation_mode: "functional_group_k_hop",
  local_view_modes: ["functional_group_k_hop", "functional_group_masking"],
  k_hops: 2,
  node_mask_ratio: 0.60,
  feature_mask_ratio: 0,
  use_batched_mask_collate: false,

  // ---------------------------------------------------------------------------
  // Masked-node reconstruction auxiliary loss -- the one thing changed vs
  // NODE_RECON_TEST_60EP: warmup_epochs 0 -> 15. Same target weight (1.0).
  // Watch loss_history.json's node_recon_loss curve for whether it now
  // actually settles into a stable, still-improving trajectory once the
  // weight reaches full strength around epoch 15, instead of the
  // bottom-then-reverse pattern seen without warmup.
  // ---------------------------------------------------------------------------
  use_node_reconstruction_loss: true,
  node_reconstruction_loss_weight: 1.0,
  node_reconstruction_loss_warmup_epochs: 15,

  // ---------------------------------------------------------------------------
  // Runtime and logging
  // ---------------------------------------------------------------------------
  seed: 1,
  device: "cuda",
  num_workers: 6,
  loader_debug: false,
  profile_timing: true,
  profile_log_every_n_batches: 200,

  // ---------------------------------------------------------------------------
  // Model dimensions -- 24 features, hidden_dim=1024 (divides evenly by 4),
  // identical to NODE_RECON_TEST_60EP / MIXED_GAT4HEADS_TEST_60EP.
  // ---------------------------------------------------------------------------
  num_features: 24,
  edge_features: 12,
  hidden_dim: 1024,
  num_layers: 3,
  gat_heads: 4,
  dropout: 0.0,
  epsilon: 0.0,
  projection_hidden_dim: 1024,
  projection_bottleneck_dim: 1024,
  projection_output_dim: 1024,
  projection_layers: 2,

  // ---------------------------------------------------------------------------
  // Training and optimization -- identical to weight_decay_fix_test.json5 /
  // MIXED_GAT4HEADS_TEST_60EP / NODE_RECON_TEST_60EP.
  // ---------------------------------------------------------------------------
  num_epochs: 60,

  batch_size: 128,

  auto_scale_lr: false,
  learning_rate: 0.000025,
  use_data_parallel: false,
  lr_scale_base: 0.00000625,
  lr_scale_reference_batch_size: 256,
  weight_decay: 0.04,
  weight_decay_start: 0.04,
  weight_decay_end: 0.2,

  teacher_temp: 0.07,
  teacher_temp_final: 0.01,
  teacher_temp_warmup_epochs: 20,

  student_temp: 0.1,
  teacher_momentum: 0.99,
  center_momentum: 0.9,
  sync_teacher_batchnorm_buffers: true,
  warmup_epochs: 20,
  final_learning_rate: 0.00001,

  validation_enabled: true,
  validation_split: 0.1,

  online_eval_enabled: false,
  online_eval_every_n_epochs: 1,
  online_eval_datasets: "lipo",
  online_eval_fixed_k: 21,
  online_eval_top_k_checkpoints: 5,
}
