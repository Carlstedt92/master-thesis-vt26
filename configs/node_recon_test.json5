{
  // ---------------------------------------------------------------------------
  // Masked-node reconstruction auxiliary loss test (iBOT/DINOv2-style): same
  // architecture/augmentation as MIXED_GAT4HEADS_TEST_60EP exactly (mixed
  // khop+masking, gat_heads=4, hidden_dim=1024, 60 epochs, already fully
  // evaluated -- see the Zinc Notebook) except use_node_reconstruction_loss
  // is now on. Mixed augmentation is required here, not just carried over --
  // the reconstruction loss only has anything to reconstruct on nodes that
  // came from a masking-based local view (functional_group_masking), so
  // running this on a khop-only config would silently be a no-op (see
  // model/config.py's comment on use_node_reconstruction_loss).
  //
  // Isolates exactly one variable against an already-known baseline: same
  // everything, +1 auxiliary loss term. First real (not just smoke-tested)
  // run of this feature -- see model/dino_ssl.py::train_step's
  // node_recon_loss diagnostic in loss_history.json to confirm it's
  // actually contributing (nonzero, not dwarfed by graph_dino_loss) once
  // training is underway, not just at the end.
  //
  // New model, trained from scratch.
  // ---------------------------------------------------------------------------
  name: "NODE_RECON_TEST_60EP",

  head_type: "dino",
  encoder_type: "GAT",
  global_pooling: "add",

  // ---------------------------------------------------------------------------
  // Data loading -- original 24-feature production dataset, staged to its
  // own scratch path by run_node_recon_test.sbatch.
  // ---------------------------------------------------------------------------
  data_path: "data/zinc/zinc_9M_data",
  use_precomputed: true,
  precomputed_data_path: "/scratch/local/precomputed_9M_data_noderecontest",
  cache_data_in_memory: false,
  precomputed_cache_in_memory: false,
  precomputed_max_cached_shards: 3,
  explicit_hydrogens: true,
  encode_hydrogen_count: false,

  // ---------------------------------------------------------------------------
  // Augmentation -- mixed: view 0 = functional_group_k_hop (k_hops=2),
  // view 1 = functional_group_masking (node_mask_ratio=0.60) -- identical to
  // MIXED_GAT4HEADS_TEST_60EP. local_augmentation_mode is set but unused/
  // overridden by local_view_modes -- kept as a valid, documented fallback
  // value only.
  // ---------------------------------------------------------------------------
  local_views: 2,
  local_augmentation_mode: "functional_group_k_hop",
  local_view_modes: ["functional_group_k_hop", "functional_group_masking"],
  k_hops: 2,
  node_mask_ratio: 0.60,
  feature_mask_ratio: 0,
  use_batched_mask_collate: false,

  // ---------------------------------------------------------------------------
  // Masked-node reconstruction auxiliary loss -- the one new thing this
  // config actually tests. Weight 1.0 (equal to the graph-level DINO loss,
  // DINOv2's own starting point) -- watch loss_history.json's
  // graph_dino_loss vs node_recon_loss curves early in training; if one
  // dwarfs the other by an order of magnitude, that's the first thing to
  // retune before drawing any conclusion from the downstream eval.
  // ---------------------------------------------------------------------------
  use_node_reconstruction_loss: true,
  node_reconstruction_loss_weight: 1.0,

  // ---------------------------------------------------------------------------
  // Runtime and logging
  // ---------------------------------------------------------------------------
  seed: 1,
  device: "cuda",
  num_workers: 6,
  loader_debug: false,
  profile_timing: true,
  profile_log_every_n_batches: 200,

  // ---------------------------------------------------------------------------
  // Model dimensions -- 24 features, hidden_dim=1024 (divides evenly by 4),
  // identical to MIXED_GAT4HEADS_TEST_60EP.
  // ---------------------------------------------------------------------------
  num_features: 24,
  edge_features: 12,
  hidden_dim: 1024,
  num_layers: 3,
  gat_heads: 4,
  dropout: 0.0,
  epsilon: 0.0,
  projection_hidden_dim: 1024,
  projection_bottleneck_dim: 1024,
  projection_output_dim: 1024,
  projection_layers: 2,

  // ---------------------------------------------------------------------------
  // Training and optimization -- identical to weight_decay_fix_test.json5 /
  // MIXED_GAT4HEADS_TEST_60EP.
  // ---------------------------------------------------------------------------
  num_epochs: 60,

  batch_size: 128,

  auto_scale_lr: false,
  learning_rate: 0.000025,
  use_data_parallel: false,
  lr_scale_base: 0.00000625,
  lr_scale_reference_batch_size: 256,
  weight_decay: 0.04,
  weight_decay_start: 0.04,
  weight_decay_end: 0.2,

  teacher_temp: 0.07,
  teacher_temp_final: 0.01,
  teacher_temp_warmup_epochs: 20,

  student_temp: 0.1,
  teacher_momentum: 0.99,
  center_momentum: 0.9,
  sync_teacher_batchnorm_buffers: true,
  warmup_epochs: 20,
  final_learning_rate: 0.00001,

  validation_enabled: true,
  validation_split: 0.1,

  online_eval_enabled: false,
  online_eval_every_n_epochs: 1,
  online_eval_datasets: "lipo",
  online_eval_fixed_k: 21,
  online_eval_top_k_checkpoints: 5,
}
