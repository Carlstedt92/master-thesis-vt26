{
  // ---------------------------------------------------------------------------
  // Extended-features test: same architecture and setup as
  // weight_decay_fix_test.json5 (the run that already confirmed the
  // weight-decay fix works -- best loss 0.884 @ epoch 44, encoder_embedding_std
  // stable through epoch 50, BatchNorm gamma RMS 0.997 at epoch 60) except
  // for the input features: num_features 24 -> 26, using the new
  // precomputed_9M_data_extended shard set (Gasteiger partial charge +
  // topological eccentricity appended per atom, see
  // datahandling/graph_creation.py's use_extended_features).
  //
  // Purpose: this is NOT expected to change downstream performance (LIPO/
  // Tox21/BACE numbers were already shown to be roughly indifferent to
  // representation quality in this regime -- see the epoch-35-vs-epoch-200
  // comparison on the production run). The point of this run is narrower:
  // confirm the now-validated fixes (weight-decay exclusion, clean 60-epoch
  // schedule) behave the same way with a wider input feature set -- i.e.
  // that the schedule dynamics we've now characterized (healthy loss/
  // encoder_embedding_std/BatchNorm-gamma through ~epoch 50, then the
  // expected late-epoch wobble as teacher momentum approaches 1.0) still
  // "kick in" correctly and nothing about the extra 2 input dims disrupts
  // that. 60 epochs is enough to see the whole shape (per the weight-decay-
  // fix run's own trajectory), so this doesn't need the full 200-epoch
  // production length.
  //
  // Since num_features changed, this is a genuinely new model -- no existing
  // checkpoint (weight_decay_fix, masking60pct, teacher_temp_fix, KHOP
  // production) is compatible or reusable as a starting point.
  // ---------------------------------------------------------------------------
  name: "EXTENDED_FEATURES_TEST_60EP",

  head_type: "dino",
  encoder_type: "GAT",
  global_pooling: "add",

  // ---------------------------------------------------------------------------
  // Data loading -- the NEW 26-feature shard set, staged to scratch by
  // run_extended_features_test.sbatch. Separate from both the original
  // 24-feature dataset and its own /proj source directory.
  // ---------------------------------------------------------------------------
  data_path: "data/zinc/zinc_9M_data",
  use_precomputed: true,
  precomputed_data_path: "/scratch/local/precomputed_9M_data_extended",
  cache_data_in_memory: false,
  precomputed_cache_in_memory: false,
  precomputed_max_cached_shards: 3,
  explicit_hydrogens: true,
  encode_hydrogen_count: false,

  // Must be true: the precomputed shards above were built with this flag on
  // (26-dim node features), and this is also what tells the online
  // evaluator (which builds LIPO graphs live from SMILES, not from the
  // precomputed shards) to use the matching 26-dim featurization. Without
  // this, online eval builds 24-dim graphs and crashes against the model's
  // 26-dim input layer the first time it runs after epoch 1 -- exactly
  // what happened on the first attempt at this run (job 17207410).
  use_extended_features: true,

  // ---------------------------------------------------------------------------
  // Augmentation -- identical to the weight-decay-fix run
  // ---------------------------------------------------------------------------
  local_views: 2,
  local_augmentation_mode: "functional_group_k_hop",
  k_hops: 2,
  node_mask_ratio: 0.05,
  feature_mask_ratio: 0,
  use_batched_mask_collate: true,

  // ---------------------------------------------------------------------------
  // Runtime and logging
  // ---------------------------------------------------------------------------
  seed: 1,
  device: "cuda",
  num_workers: 6,
  loader_debug: false,
  profile_timing: true,
  profile_log_every_n_batches: 200,

  // ---------------------------------------------------------------------------
  // Model dimensions -- 26 features (24 base + Gasteiger charge +
  // topological eccentricity), everything else identical to production.
  // ---------------------------------------------------------------------------
  num_features: 26,
  edge_features: 12,
  hidden_dim: 1024,
  num_layers: 3,
  dropout: 0.0,
  epsilon: 0.0,
  projection_hidden_dim: 1024,
  projection_bottleneck_dim: 1024,
  projection_output_dim: 1024,
  projection_layers: 2,

  // ---------------------------------------------------------------------------
  // Training and optimization -- identical to weight_decay_fix_test.json5
  // ---------------------------------------------------------------------------
  num_epochs: 60,

  // Per-GPU batch size. With 8 GPUs (DDP), global effective batch = 1024,
  // matching the production run's single-GPU batch_size=1024.
  batch_size: 128,

  // Explicit LR matching what auto_scale_lr computed for the production
  // run's global batch of 1024: lr_scale_base(0.00000625) * 1024/256 = 0.000025.
  auto_scale_lr: false,
  learning_rate: 0.000025,
  use_data_parallel: false,
  lr_scale_base: 0.00000625,
  lr_scale_reference_batch_size: 256,
  weight_decay: 0.04,
  weight_decay_start: 0.04,
  weight_decay_end: 0.2,

  // Production's exact (inverted) values -- already shown not to matter.
  teacher_temp: 0.07,
  teacher_temp_final: 0.01,
  teacher_temp_warmup_epochs: 20,

  student_temp: 0.1,
  teacher_momentum: 0.99,
  center_momentum: 0.9,
  sync_teacher_batchnorm_buffers: true,
  warmup_epochs: 20,
  final_learning_rate: 0.00001,

  validation_enabled: true,
  validation_split: 0.1,

  online_eval_enabled: true,
  online_eval_every_n_epochs: 1,
  online_eval_datasets: "lipo",
  online_eval_fixed_k: 21,
  online_eval_top_k_checkpoints: 5,
}
