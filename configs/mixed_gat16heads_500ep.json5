{
  // ---------------------------------------------------------------------------
  // Supervisor-requested 500-epoch run of the 16-head mixed-augmentation model
  // (MIXED_GAT16HEADS_TEST_60EP's architecture, extended from 60 to 500 epochs).
  // At ~20.46 min/epoch (measured from MIXED_GAT16HEADS_TEST_60EP's own 60-epoch
  // run: 1227.4 min total), 500 epochs is ~170.5 hours -- far beyond Berzelius's
  // 48h job limit, so this MUST be split across multiple sbatch submissions via
  // continue_training.py, resuming from checkpoints between them.
  //
  // num_epochs is set to the TRUE FINAL TARGET (500) here, from this very first
  // job, and must NEVER be overridden on any later resume (no --target-epochs,
  // no --extra-epochs -- see run_mixed_gat16heads_500ep_resume.sbatch, which is
  // built to never pass either). This is the fix for the exact bug already
  // root-caused in this project: KHOP_B1024_H1024_200EP_GAT_9M_ZINC's num_epochs
  // was bumped incrementally across resumes (40->80->120->160->200), which
  // rebuilds the cosine LR/momentum/weight-decay schedule fresh at every
  // resume (see training/dino_training.py::_prepare_schedule_bundle) -- meaning
  // that model's LR schedule never ran its full planned course except in the
  // very last segment, and every earlier checkpoint was captured mid-decay of a
  // target that kept moving. TrainingManager writes models/<name>/config.json
  // on every single training call (fresh or resumed), and continue_training.py
  // defaults to reading FROM that file when no --config/--target-epochs/
  // --extra-epochs is given -- so as long as no resume ever overrides
  // num_epochs, config.json keeps reading 500 forever, and
  // _prepare_schedule_bundle's cache check (loaded_num_epochs ==
  // config.num_epochs) sees no change and just reloads the same
  // schedule_state.pt unchanged every time. One continuous cosine decay across
  // as many sub-jobs as it takes.
  // ---------------------------------------------------------------------------
  name: "MIXED_GAT16HEADS_500EP",

  head_type: "dino",
  encoder_type: "GAT",
  global_pooling: "add",

  // ---------------------------------------------------------------------------
  // Data loading -- original 24-feature production dataset, staged to its own
  // scratch path by run_mixed_gat16heads_500ep.sbatch /
  // run_mixed_gat16heads_500ep_resume.sbatch.
  // ---------------------------------------------------------------------------
  data_path: "data/zinc/zinc_9M_data",
  use_precomputed: true,
  precomputed_data_path: "/scratch/local/precomputed_9M_data_mixed16_500ep",
  cache_data_in_memory: false,
  precomputed_cache_in_memory: false,
  precomputed_max_cached_shards: 3,
  explicit_hydrogens: true,
  encode_hydrogen_count: false,

  // ---------------------------------------------------------------------------
  // Augmentation -- identical to MIXED_GAT16HEADS_TEST_60EP: view 0 =
  // functional_group_k_hop (k_hops=2), view 1 = functional_group_masking
  // (node_mask_ratio=0.60, feature_mask_ratio=0). local_augmentation_mode is
  // set but unused/overridden by local_view_modes -- kept as a valid,
  // documented fallback value only.
  // ---------------------------------------------------------------------------
  local_views: 2,
  local_augmentation_mode: "functional_group_k_hop",
  local_view_modes: ["functional_group_k_hop", "functional_group_masking"],
  k_hops: 2,
  node_mask_ratio: 0.60,
  feature_mask_ratio: 0,
  use_batched_mask_collate: false,

  // ---------------------------------------------------------------------------
  // Runtime and logging
  // ---------------------------------------------------------------------------
  seed: 1,
  device: "cuda",
  num_workers: 6,
  loader_debug: false,
  profile_timing: true,
  profile_log_every_n_batches: 200,

  // ---------------------------------------------------------------------------
  // Model dimensions -- identical to MIXED_GAT16HEADS_TEST_60EP: 24 features,
  // hidden_dim=1024 (divides evenly by 16).
  // ---------------------------------------------------------------------------
  num_features: 24,
  edge_features: 12,
  hidden_dim: 1024,
  num_layers: 3,
  gat_heads: 16,
  dropout: 0.0,
  epsilon: 0.0,
  projection_hidden_dim: 1024,
  projection_bottleneck_dim: 1024,
  projection_output_dim: 1024,
  projection_layers: 2,

  // ---------------------------------------------------------------------------
  // Training and optimization -- identical to MIXED_GAT16HEADS_TEST_60EP
  // except num_epochs: 60 -> 500. warmup_epochs/teacher_temp_warmup_epochs
  // kept at 20 (absolute, not rescaled as a fraction of the run) -- matches
  // how the original 200-epoch production model was configured (also 20
  // regardless of overall length), not something newly introduced here.
  // ---------------------------------------------------------------------------
  num_epochs: 500,

  batch_size: 128,

  auto_scale_lr: false,
  learning_rate: 0.000025,
  use_data_parallel: false,
  lr_scale_base: 0.00000625,
  lr_scale_reference_batch_size: 256,
  weight_decay: 0.04,
  weight_decay_start: 0.04,
  weight_decay_end: 0.2,

  teacher_temp: 0.07,
  teacher_temp_final: 0.01,
  teacher_temp_warmup_epochs: 20,

  student_temp: 0.1,
  teacher_momentum: 0.99,
  center_momentum: 0.9,
  sync_teacher_batchnorm_buffers: true,
  warmup_epochs: 20,
  final_learning_rate: 0.00001,

  validation_enabled: true,
  validation_split: 0.1,

  // Checkpoint every 5 epochs instead of the project-wide default of 10 --
  // this run is long/expensive enough (~1,364 GPU-hours total, split across
  // ~4-5 wall-clock-limited sub-jobs) that bounding the worst-case loss per
  // resume boundary to 4 epochs (~1.4h) instead of 9 (~3h) is worth the
  // extra checkpoint I/O. Only affects this config -- every other config in
  // the project keeps the default 10.
  checkpoint_save_every_n_epochs: 5,

  online_eval_enabled: false,
  online_eval_every_n_epochs: 1,
  online_eval_datasets: "lipo",
  online_eval_fixed_k: 21,
  online_eval_top_k_checkpoints: 5,
}
