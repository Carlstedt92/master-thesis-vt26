{
  // ---------------------------------------------------------------------------
  // 16-head follow-up to NODE_RECON_WARMUP_TEST_60EP. The node-recon-vs-no-
  // node-recon comparison so far (MIXED_GAT4HEADS_TEST_60EP vs
  // NODE_RECON_WARMUP_TEST_60EP, both 4-head) found a modest but fairly
  // consistent net positive from the node-reconstruction loss (wins on
  // LIPO/BBB_Martins/hERG/AMES, loses on BACE/Tox21, deltas all small,
  // 0.004-0.014) -- but that's only been tested on a 4-head GAT. This config
  // isolates whether the same effect holds on the 16-head architecture
  // (MIXED_GAT16HEADS_TEST_60EP's own config, the one actually used for the
  // 500-epoch production run) by taking that config as the base and adding
  // ONLY the node-reconstruction loss block from
  // configs/node_recon_warmup_test.json5 (weight=1.0, 15-epoch warmup, same
  // rationale as there) -- confirmed via diff that mixed_gat16heads_test.json5
  // and node_recon_warmup_test.json5 are otherwise identical except gat_heads
  // (16 vs 4), so this is a clean, single-variable addition.
  // ---------------------------------------------------------------------------
  name: "MIXED_GAT16HEADS_NODE_RECON_WARMUP_TEST_60EP",

  head_type: "dino",
  encoder_type: "GAT",
  global_pooling: "add",

  data_path: "data/zinc/zinc_9M_data",
  use_precomputed: true,
  precomputed_data_path: "/scratch/local/precomputed_9M_data_mixed16noderecon",
  cache_data_in_memory: false,
  precomputed_cache_in_memory: false,
  precomputed_max_cached_shards: 3,
  explicit_hydrogens: true,
  encode_hydrogen_count: false,

  local_views: 2,
  local_augmentation_mode: "functional_group_k_hop",
  local_view_modes: ["functional_group_k_hop", "functional_group_masking"],
  k_hops: 2,
  node_mask_ratio: 0.60,
  feature_mask_ratio: 0,
  use_batched_mask_collate: false,

  // Masked-node reconstruction auxiliary loss -- identical block to
  // configs/node_recon_warmup_test.json5.
  use_node_reconstruction_loss: true,
  node_reconstruction_loss_weight: 1.0,
  node_reconstruction_loss_warmup_epochs: 15,

  seed: 1,
  device: "cuda",
  num_workers: 6,
  loader_debug: false,
  profile_timing: true,
  profile_log_every_n_batches: 200,

  num_features: 24,
  edge_features: 12,
  hidden_dim: 1024,
  num_layers: 3,
  gat_heads: 16,
  dropout: 0.0,
  epsilon: 0.0,
  projection_hidden_dim: 1024,
  projection_bottleneck_dim: 1024,
  projection_output_dim: 1024,
  projection_layers: 2,

  num_epochs: 60,

  batch_size: 128,

  auto_scale_lr: false,
  learning_rate: 0.000025,
  use_data_parallel: false,
  lr_scale_base: 0.00000625,
  lr_scale_reference_batch_size: 256,
  weight_decay: 0.04,
  weight_decay_start: 0.04,
  weight_decay_end: 0.2,

  teacher_temp: 0.07,
  teacher_temp_final: 0.01,
  teacher_temp_warmup_epochs: 20,

  student_temp: 0.1,
  teacher_momentum: 0.99,
  center_momentum: 0.9,
  sync_teacher_batchnorm_buffers: true,
  warmup_epochs: 20,
  final_learning_rate: 0.00001,

  validation_enabled: true,
  validation_split: 0.1,

  online_eval_enabled: false,
  online_eval_every_n_epochs: 1,
  online_eval_datasets: "lipo",
  online_eval_fixed_k: 21,
  online_eval_top_k_checkpoints: 5,
}
