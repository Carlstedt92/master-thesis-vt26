{
  // ---------------------------------------------------------------------------
  // Feature-dropout test: same setup as masking60pct_extended_features_test.json5
  // (26 features, functional_group_masking at 60% node mask ratio) except
  // feature_mask_ratio 0 -> 0.15 (the codebase default, previously never
  // actually exercised in any run -- both extended-feature configs so far
  // had it at 0).
  //
  // Purpose: test whether generic (untargeted) feature-column dropout on
  // local/student views -- a random subset of ALL 26 columns, not
  // specifically charge/eccentricity -- affects the downstream regression
  // seen with the extended (Gasteiger charge + topological eccentricity)
  // features. This is a first, cheap-to-run pass using the existing
  // feature_mask_ratio knob as-is (no code changes); a version that
  // specifically/preferentially targets just the 2 new columns was discussed
  // but deferred until shortcut learning is more firmly established as the
  // cause (see check_shortcut_learning.py -- signal detected but weak, not
  // yet conclusive).
  // ---------------------------------------------------------------------------
  name: "MASKING60PCT_EXTFEAT_FEATMASK_TEST_60EP",

  head_type: "dino",
  encoder_type: "GAT",
  global_pooling: "add",

  // ---------------------------------------------------------------------------
  // Data loading -- same 26-feature shard set as masking60pct_extended_features_test,
  // staged to its own scratch path by run_masking60pct_extended_featmask_test.sbatch.
  // ---------------------------------------------------------------------------
  data_path: "data/zinc/zinc_9M_data",
  use_precomputed: true,
  precomputed_data_path: "/scratch/local/precomputed_9M_data_extended_mask60_fm",
  cache_data_in_memory: false,
  precomputed_cache_in_memory: false,
  precomputed_max_cached_shards: 3,
  explicit_hydrogens: true,
  encode_hydrogen_count: false,

  // ---------------------------------------------------------------------------
  // Augmentation -- functional_group_masking at 60% node mask ratio, same as
  // masking60pct_extended_features_test.json5, but with feature_mask_ratio
  // turned on (0 -> 0.15).
  // ---------------------------------------------------------------------------
  local_views: 2,
  local_augmentation_mode: "functional_group_masking",
  k_hops: 2,
  node_mask_ratio: 0.60,
  feature_mask_ratio: 0.15,
  use_batched_mask_collate: true,

  // ---------------------------------------------------------------------------
  // Runtime and logging
  // ---------------------------------------------------------------------------
  seed: 1,
  device: "cuda",
  num_workers: 6,
  loader_debug: false,
  profile_timing: true,
  profile_log_every_n_batches: 200,

  // ---------------------------------------------------------------------------
  // Model dimensions -- 26 features (24 base + Gasteiger charge +
  // topological eccentricity), everything else identical to production.
  // ---------------------------------------------------------------------------
  num_features: 26,
  edge_features: 12,
  hidden_dim: 1024,
  num_layers: 3,
  dropout: 0.0,
  epsilon: 0.0,
  projection_hidden_dim: 1024,
  projection_bottleneck_dim: 1024,
  projection_output_dim: 1024,
  projection_layers: 2,

  // Must be true: shards above were built with this flag on (26-dim node
  // features), and this also tells the online evaluator (which builds LIPO
  // graphs live from SMILES, not from the shards) to use matching 26-dim
  // featurization -- without it, online eval crashes the first time it runs
  // after epoch 1.
  use_extended_features: true,

  // ---------------------------------------------------------------------------
  // Training and optimization -- identical to masking60pct_extended_features_test.json5
  // ---------------------------------------------------------------------------
  num_epochs: 60,

  // Per-GPU batch size. With 8 GPUs (DDP), global effective batch = 1024,
  // matching the production run's single-GPU batch_size=1024.
  batch_size: 128,

  // Explicit LR matching what auto_scale_lr computed for the production
  // run's global batch of 1024: lr_scale_base(0.00000625) * 1024/256 = 0.000025.
  auto_scale_lr: false,
  learning_rate: 0.000025,
  use_data_parallel: false,
  lr_scale_base: 0.00000625,
  lr_scale_reference_batch_size: 256,
  weight_decay: 0.04,
  weight_decay_start: 0.04,
  weight_decay_end: 0.2,

  // Production's exact (inverted) values -- already shown not to matter.
  teacher_temp: 0.07,
  teacher_temp_final: 0.01,
  teacher_temp_warmup_epochs: 20,

  student_temp: 0.1,
  teacher_momentum: 0.99,
  center_momentum: 0.9,
  sync_teacher_batchnorm_buffers: true,
  warmup_epochs: 20,
  final_learning_rate: 0.00001,

  validation_enabled: true,
  validation_split: 0.1,

  online_eval_enabled: true,
  online_eval_every_n_epochs: 1,
  online_eval_datasets: "lipo",
  online_eval_fixed_k: 21,
  online_eval_top_k_checkpoints: 5,
}
