{
  // ---------------------------------------------------------------------------
  // Teacher-temperature-direction ablation: same architecture as the
  // production KHOP run (configs/production/khop_200ep.json5), run as a
  // single un-segmented 60-epoch job (no resume/chaining, so the just-fixed
  // schedule-freeze bug in _prepare_schedule_bundle never comes into play),
  // with teacher_temp/teacher_temp_final SWAPPED relative to the production
  // config (0.07->0.01 there; 0.01->0.07 here) so the teacher warms from a
  // sharp start to a SOFTER held value for the rest of training, matching
  // DINO's actual paper/reference behavior instead of the inverted direction
  // used in the production run.
  //
  // Launched via torchrun on 8 GPUs (run_teacher_temp_test.sbatch) for wall-
  // clock speed. batch_size is PER-RANK (128); with 8 ranks the global
  // effective batch is 1024, matching the production run's single-GPU
  // batch_size=1024 exactly. auto_scale_lr is disabled and learning_rate is
  // set explicitly to what auto_scale_lr would have computed for a global
  // batch of 1024 in the production config (lr_scale_base * 1024/256 =
  // 0.000025), so the optimization dynamics match as closely as possible --
  // the only intentional difference from "epochs 1-60 of the production
  // run" is the teacher_temp direction.
  //
  // Caveat: the production run's actual epochs 1-40 were themselves shaped
  // by a 40-epoch-total schedule (segment 1's config), and this test's
  // schedules are shaped for a 60-epoch total -- not a perfect apples-to-
  // apples pace match, but comparable in kind (both short/fast schedules,
  // not the intended 200-epoch spread). Compare via the diagnostic trends
  // (encoder_embedding_std, entropy, SSL loss) rather than epoch-for-epoch.
  // ---------------------------------------------------------------------------
  name: "TEACHER_TEMP_FIX_TEST_60EP",

  head_type: "dino",
  encoder_type: "GAT",
  global_pooling: "add",

  // ---------------------------------------------------------------------------
  // Data loading -- full 9M-shard production dataset, staged to scratch by
  // run_teacher_temp_test.sbatch exactly like the production run does.
  // ---------------------------------------------------------------------------
  data_path: "data/zinc/zinc_9M_data",
  use_precomputed: true,
  precomputed_data_path: "/scratch/local/precomputed_9M_data_temptest",
  cache_data_in_memory: false,
  precomputed_cache_in_memory: false,
  precomputed_max_cached_shards: 3,
  explicit_hydrogens: true,
  encode_hydrogen_count: false,

  // ---------------------------------------------------------------------------
  // Augmentation -- identical to production
  // ---------------------------------------------------------------------------
  local_views: 2,
  local_augmentation_mode: "functional_group_k_hop",
  k_hops: 2,
  node_mask_ratio: 0.05,
  feature_mask_ratio: 0,
  use_batched_mask_collate: true,

  // ---------------------------------------------------------------------------
  // Runtime and logging
  // ---------------------------------------------------------------------------
  seed: 1,
  device: "cuda",
  num_workers: 6,
  loader_debug: false,
  profile_timing: true,
  profile_log_every_n_batches: 200,

  // ---------------------------------------------------------------------------
  // Model dimensions -- identical to production (hidden_dim=1024)
  // ---------------------------------------------------------------------------
  num_features: 24,
  edge_features: 12,
  hidden_dim: 1024,
  num_layers: 3,
  dropout: 0.0,
  epsilon: 0.0,
  projection_hidden_dim: 1024,
  projection_bottleneck_dim: 1024,
  projection_output_dim: 1024,
  projection_layers: 2,

  // ---------------------------------------------------------------------------
  // Training and optimization
  // ---------------------------------------------------------------------------
  num_epochs: 60,

  // Per-GPU batch size. With 8 GPUs (DDP), global effective batch = 1024,
  // matching the production run's single-GPU batch_size=1024.
  batch_size: 128,

  // Explicit LR matching what auto_scale_lr computed for the production
  // run's global batch of 1024: lr_scale_base(0.00000625) * 1024/256 = 0.000025.
  auto_scale_lr: false,
  learning_rate: 0.000025,
  use_data_parallel: false,
  lr_scale_base: 0.00000625,
  lr_scale_reference_batch_size: 256,
  weight_decay: 0.04,
  weight_decay_start: 0.04,
  weight_decay_end: 0.2,

  // Teacher temperature -- SWAPPED from production (0.07->0.01) to match
  // DINO's actual direction: sharp start, softer held value.
  teacher_temp: 0.01,
  teacher_temp_final: 0.07,
  teacher_temp_warmup_epochs: 20,

  student_temp: 0.1,
  teacher_momentum: 0.99,
  center_momentum: 0.9,
  sync_teacher_batchnorm_buffers: true,
  warmup_epochs: 20,
  final_learning_rate: 0.00001,

  validation_enabled: true,
  validation_split: 0.1,

  online_eval_enabled: true,
  online_eval_every_n_epochs: 1,
  online_eval_datasets: "lipo",
  online_eval_fixed_k: 21,
  online_eval_top_k_checkpoints: 5,
}
