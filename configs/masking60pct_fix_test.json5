{
  // ---------------------------------------------------------------------------
  // Masking-augmentation ablation: same setup as the weight-decay-fix test
  // (configs/weight_decay_fix_test.json5) -- full 9M-shard dataset, 60
  // epochs, 8-GPU DDP, production's exact teacher-temp settings, and all the
  // fixes made this session baked into the code (schedule-freeze fix,
  // parallelized validation, weight-decay exclusion for BatchNorm gamma/beta
  // and biases). The only intentional difference from weight_decay_fix_test
  // is the augmentation mode: functional_group_k_hop -> functional_group_masking
  // at a 60% node mask ratio, to see whether the collapse mechanism (and the
  // fix for it) behaves the same way under a structurally different local-view
  // augmentation, not just the KHOP mode all prior ablations used.
  //
  // 60% is deliberately aggressive (existing hidden_compare configs only went
  // up to 30%) -- the goal is to stress-test the fix under a harder
  // augmentation regime, not to find a production-quality masking config.
  // ---------------------------------------------------------------------------
  name: "MASKING60PCT_FIX_TEST_60EP",

  head_type: "dino",
  encoder_type: "GAT",
  global_pooling: "add",

  // ---------------------------------------------------------------------------
  // Data loading -- full 9M-shard production dataset, staged to scratch by
  // run_masking60pct_test.sbatch exactly like the other fix-ablation runs.
  // ---------------------------------------------------------------------------
  data_path: "data/zinc/zinc_9M_data",
  use_precomputed: true,
  precomputed_data_path: "/scratch/local/precomputed_9M_data_mask60test",
  cache_data_in_memory: false,
  precomputed_cache_in_memory: false,
  precomputed_max_cached_shards: 3,
  explicit_hydrogens: true,
  encode_hydrogen_count: false,

  // ---------------------------------------------------------------------------
  // Augmentation -- functional_group_masking at 60% node mask ratio (the one
  // intentional difference from weight_decay_fix_test.json5).
  // ---------------------------------------------------------------------------
  local_views: 2,
  local_augmentation_mode: "functional_group_masking",
  k_hops: 2,
  node_mask_ratio: 0.60,
  feature_mask_ratio: 0,
  use_batched_mask_collate: true,

  // ---------------------------------------------------------------------------
  // Runtime and logging
  // ---------------------------------------------------------------------------
  seed: 1,
  device: "cuda",
  num_workers: 6,
  loader_debug: false,
  profile_timing: true,
  profile_log_every_n_batches: 200,

  // ---------------------------------------------------------------------------
  // Model dimensions -- identical to production (hidden_dim=1024)
  // ---------------------------------------------------------------------------
  num_features: 24,
  edge_features: 12,
  hidden_dim: 1024,
  num_layers: 3,
  dropout: 0.0,
  epsilon: 0.0,
  projection_hidden_dim: 1024,
  projection_bottleneck_dim: 1024,
  projection_output_dim: 1024,
  projection_layers: 2,

  // ---------------------------------------------------------------------------
  // Training and optimization
  // ---------------------------------------------------------------------------
  num_epochs: 60,

  // Per-GPU batch size. With 8 GPUs (DDP), global effective batch = 1024,
  // matching the production run's single-GPU batch_size=1024.
  batch_size: 128,

  // Explicit LR matching what auto_scale_lr computed for the production
  // run's global batch of 1024: lr_scale_base(0.00000625) * 1024/256 = 0.000025.
  auto_scale_lr: false,
  learning_rate: 0.000025,
  use_data_parallel: false,
  lr_scale_base: 0.00000625,
  lr_scale_reference_batch_size: 256,
  weight_decay: 0.04,
  weight_decay_start: 0.04,
  weight_decay_end: 0.2,

  // Production's exact (inverted) values -- already shown not to be the
  // cause of the collapse, kept as-is for consistency with the other
  // fix-ablation runs.
  teacher_temp: 0.07,
  teacher_temp_final: 0.01,
  teacher_temp_warmup_epochs: 20,

  student_temp: 0.1,
  teacher_momentum: 0.99,
  center_momentum: 0.9,
  sync_teacher_batchnorm_buffers: true,
  warmup_epochs: 20,
  final_learning_rate: 0.00001,

  validation_enabled: true,
  validation_split: 0.1,

  online_eval_enabled: true,
  online_eval_every_n_epochs: 1,
  online_eval_datasets: "lipo",
  online_eval_fixed_k: 21,
  online_eval_top_k_checkpoints: 5,
}
