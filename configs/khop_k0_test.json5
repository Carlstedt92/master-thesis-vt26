{
  // ---------------------------------------------------------------------------
  // KHOP task-difficulty ablation: k_hops 2 -> 0. Same setup as
  // weight_decay_fix_test.json5 (24 features, functional_group_k_hop,
  // all validated fixes from this session) except k_hops=0.
  //
  // Purpose: supervisor observed the SSL loss drops very quickly even on the
  // 24-feature baseline, suggesting the instance-discrimination task may be
  // too easy at k_hops=2 -- the local (student) view may already be similar
  // enough to the global (teacher) view that little genuine structural
  // inference is required. Shrinking k_hops widens the information gap
  // between local and global views, which should make the task harder.
  //
  // k_hops=0 does NOT mean an isolated atom here: with the widened
  // functional-group SMARTS patterns (datahandling/graph_augmentation.py,
  // Phenol/Aromatic_Ring_6/Aromatic_Ring_5 fixes -- see
  // measure_khop_fallback_rate.py, fallback rate 1.07% -> 0.20%), the local
  // view seed is the raw SMARTS-matched functional-group atoms themselves
  // (2-7 atoms depending on which group matched, e.g. the whole benzo/
  // heteroaryl ring for aromatic systems), with zero k-hop expansion beyond
  // that. This tests whether the bare functional-group identity alone
  // (no surrounding structural context) still carries enough signal to
  // solve the discrimination task.
  // ---------------------------------------------------------------------------
  name: "KHOP_K0_TEST_60EP",

  head_type: "dino",
  encoder_type: "GAT",
  global_pooling: "add",

  // ---------------------------------------------------------------------------
  // Data loading -- original 24-feature production dataset, staged to its
  // own scratch path by run_khop_k0_test.sbatch.
  // ---------------------------------------------------------------------------
  data_path: "data/zinc/zinc_9M_data",
  use_precomputed: true,
  precomputed_data_path: "/scratch/local/precomputed_9M_data_k0test",
  cache_data_in_memory: false,
  precomputed_cache_in_memory: false,
  precomputed_max_cached_shards: 3,
  explicit_hydrogens: true,
  encode_hydrogen_count: false,

  // ---------------------------------------------------------------------------
  // Augmentation -- identical to weight_decay_fix_test.json5 except k_hops.
  // ---------------------------------------------------------------------------
  local_views: 2,
  local_augmentation_mode: "functional_group_k_hop",
  k_hops: 0,
  node_mask_ratio: 0.05,
  feature_mask_ratio: 0,
  use_batched_mask_collate: true,

  // ---------------------------------------------------------------------------
  // Runtime and logging
  // ---------------------------------------------------------------------------
  seed: 1,
  device: "cuda",
  num_workers: 6,
  loader_debug: false,
  profile_timing: true,
  profile_log_every_n_batches: 200,

  // ---------------------------------------------------------------------------
  // Model dimensions -- identical to production (24 features, hidden_dim=1024)
  // ---------------------------------------------------------------------------
  num_features: 24,
  edge_features: 12,
  hidden_dim: 1024,
  num_layers: 3,
  dropout: 0.0,
  epsilon: 0.0,
  projection_hidden_dim: 1024,
  projection_bottleneck_dim: 1024,
  projection_output_dim: 1024,
  projection_layers: 2,

  // ---------------------------------------------------------------------------
  // Training and optimization -- identical to weight_decay_fix_test.json5
  // ---------------------------------------------------------------------------
  num_epochs: 60,

  batch_size: 128,

  auto_scale_lr: false,
  learning_rate: 0.000025,
  use_data_parallel: false,
  lr_scale_base: 0.00000625,
  lr_scale_reference_batch_size: 256,
  weight_decay: 0.04,
  weight_decay_start: 0.04,
  weight_decay_end: 0.2,

  teacher_temp: 0.07,
  teacher_temp_final: 0.01,
  teacher_temp_warmup_epochs: 20,

  student_temp: 0.1,
  teacher_momentum: 0.99,
  center_momentum: 0.9,
  sync_teacher_batchnorm_buffers: true,
  warmup_epochs: 20,
  final_learning_rate: 0.00001,

  validation_enabled: true,
  validation_split: 0.1,

  online_eval_enabled: true,
  online_eval_every_n_epochs: 1,
  online_eval_datasets: "lipo",
  online_eval_fixed_k: 21,
  online_eval_top_k_checkpoints: 5,
}
