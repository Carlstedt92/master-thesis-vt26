{
  // ---------------------------------------------------------------------------
  // Multi-head GAT complexity ablation: same setup as weight_decay_fix_test.json5
  // (24 features, functional_group_k_hop, all validated fixes from this
  // session -- weight-decay exclusion, updated functional-group SMARTS
  // patterns) except gat_heads 1 -> 3.
  //
  // Per supervisor decision: increase model complexity by using 3 GAT
  // attention heads instead of 1. Heads are concatenated (standard GAT-paper
  // / Transformer-style multi-head attention, not averaged) -- each head
  // computes hidden_dim/heads channels, concatenated back to hidden_dim, so
  // hidden_dim must divide evenly by heads. 1024 doesn't divide by 3, so
  // hidden_dim is bumped to 1026 (342 per head) -- the nearest multiple of 3
  // to the original 1024. This keeps total parameter count essentially
  // unchanged vs. a 1-head model at hidden_dim=1026 (verified: 6,400,188
  // params either way) -- the "complexity increase" is architectural
  // (3 independent attention patterns per layer instead of 1), not a raw
  // parameter-count increase. See model/gnn_model.py's GATEncoder for the
  // implementation (heads param, concat=True, hidden_dim % heads == 0
  // enforced).
  //
  // New model, trained from scratch -- num_features unchanged (24) but
  // hidden_dim changed, so no existing checkpoint is compatible.
  // ---------------------------------------------------------------------------
  name: "KHOP_GAT3HEADS_TEST_60EP",

  head_type: "dino",
  encoder_type: "GAT",
  global_pooling: "add",

  // ---------------------------------------------------------------------------
  // Data loading -- original 24-feature production dataset, staged to its
  // own scratch path by run_khop_gat3heads_test.sbatch.
  // ---------------------------------------------------------------------------
  data_path: "data/zinc/zinc_9M_data",
  use_precomputed: true,
  precomputed_data_path: "/scratch/local/precomputed_9M_data_gat3test",
  cache_data_in_memory: false,
  precomputed_cache_in_memory: false,
  precomputed_max_cached_shards: 3,
  explicit_hydrogens: true,
  encode_hydrogen_count: false,

  // ---------------------------------------------------------------------------
  // Augmentation -- identical to weight_decay_fix_test.json5 (k_hops=2,
  // functional_group_k_hop, updated SMARTS patterns already in the codebase).
  // ---------------------------------------------------------------------------
  local_views: 2,
  local_augmentation_mode: "functional_group_k_hop",
  k_hops: 2,
  node_mask_ratio: 0.05,
  feature_mask_ratio: 0,
  use_batched_mask_collate: true,

  // ---------------------------------------------------------------------------
  // Runtime and logging
  // ---------------------------------------------------------------------------
  seed: 1,
  device: "cuda",
  num_workers: 6,
  loader_debug: false,
  profile_timing: true,
  profile_log_every_n_batches: 200,

  // ---------------------------------------------------------------------------
  // Model dimensions -- 24 features, hidden_dim bumped 1024 -> 1026 (nearest
  // multiple of 3) to support gat_heads=3 with concatenated attention.
  // ---------------------------------------------------------------------------
  num_features: 24,
  edge_features: 12,
  hidden_dim: 1026,
  num_layers: 3,
  gat_heads: 3,
  dropout: 0.0,
  epsilon: 0.0,
  projection_hidden_dim: 1026,
  projection_bottleneck_dim: 1026,
  projection_output_dim: 1026,
  projection_layers: 2,

  // ---------------------------------------------------------------------------
  // Training and optimization -- identical to weight_decay_fix_test.json5
  // ---------------------------------------------------------------------------
  num_epochs: 60,

  batch_size: 128,

  auto_scale_lr: false,
  learning_rate: 0.000025,
  use_data_parallel: false,
  lr_scale_base: 0.00000625,
  lr_scale_reference_batch_size: 256,
  weight_decay: 0.04,
  weight_decay_start: 0.04,
  weight_decay_end: 0.2,

  teacher_temp: 0.07,
  teacher_temp_final: 0.01,
  teacher_temp_warmup_epochs: 20,

  student_temp: 0.1,
  teacher_momentum: 0.99,
  center_momentum: 0.9,
  sync_teacher_batchnorm_buffers: true,
  warmup_epochs: 20,
  final_learning_rate: 0.00001,

  validation_enabled: true,
  validation_split: 0.1,

  online_eval_enabled: true,
  online_eval_every_n_epochs: 1,
  online_eval_datasets: "lipo",
  online_eval_fixed_k: 21,
  online_eval_top_k_checkpoints: 5,
}
