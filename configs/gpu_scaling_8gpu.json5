{
  // ---------------------------------------------------------------------------
  // GPU scaling test: same architecture/hyperparameters as the production
  // KHOP run (configs/production/khop_200ep.json5), but DDP across 8 GPUs
  // instead of 1, online eval/validation disabled to isolate pure training
  // throughput, and only 1 epoch -- this exists purely to measure epoch
  // wall-clock time for comparison against the production run's single-GPU
  // baseline (~84.5 min/epoch measured from its live logs), to extrapolate
  // GPU-count and dataset-size scaling for August's larger runs.
  // ---------------------------------------------------------------------------
  name: "GPU_SCALING_TEST_8GPU",

  head_type: "dino",
  encoder_type: "GAT",
  global_pooling: "add",

  // ---------------------------------------------------------------------------
  // Data loading -- full 9M-shard production dataset, staged to scratch by
  // run_gpu_scaling.sbatch exactly like the production run does.
  // ---------------------------------------------------------------------------
  data_path: "data/zinc/zinc_9M_data",
  use_precomputed: true,
  precomputed_data_path: "/scratch/local/precomputed_9M_data_scaling8",
  cache_data_in_memory: false,
  precomputed_cache_in_memory: false,
  precomputed_max_cached_shards: 3,
  explicit_hydrogens: true,
  encode_hydrogen_count: false,

  // ---------------------------------------------------------------------------
  // Augmentation -- identical to production
  // ---------------------------------------------------------------------------
  local_views: 2,
  local_augmentation_mode: "functional_group_k_hop",
  k_hops: 2,
  node_mask_ratio: 0.05,
  feature_mask_ratio: 0,
  use_batched_mask_collate: true,

  // ---------------------------------------------------------------------------
  // Runtime and logging
  // ---------------------------------------------------------------------------
  seed: 1,
  device: "cuda",
  num_workers: 6,
  loader_debug: false,
  profile_timing: true,
  profile_log_every_n_batches: 100,

  // ---------------------------------------------------------------------------
  // Model dimensions -- identical to production (hidden_dim=1024)
  // ---------------------------------------------------------------------------
  num_features: 24,
  edge_features: 12,
  hidden_dim: 1024,
  num_layers: 3,
  dropout: 0.0,
  epsilon: 0.0,
  projection_hidden_dim: 1024,
  projection_bottleneck_dim: 1024,
  projection_output_dim: 1024,
  projection_layers: 2,

  // ---------------------------------------------------------------------------
  // Training and optimization
  // ---------------------------------------------------------------------------
  // Only 1 epoch -- this is a throughput measurement, not a quality run.
  num_epochs: 1,

  // Per-GPU batch size, identical to production (so global batch size scales
  // with GPU count -- this is the actual scaling behavior August's HPO runs
  // would use, not an artificially fixed global batch size).
  batch_size: 1024,

  auto_scale_lr: true,
  // DDP replaces DataParallel -- must be off (DINOGraphSSL raises otherwise).
  use_data_parallel: false,
  lr_scale_base: 0.00000625,
  lr_scale_reference_batch_size: 256,
  learning_rate: 0.001,
  weight_decay: 0.04,
  weight_decay_start: 0.04,
  weight_decay_end: 0.2,
  teacher_temp: 0.07,
  teacher_temp_final: 0.01,
  teacher_temp_warmup_epochs: 20,
  student_temp: 0.1,
  teacher_momentum: 0.99,
  center_momentum: 0.9,
  sync_teacher_batchnorm_buffers: true,
  warmup_epochs: 20,
  final_learning_rate: 0.00001,

  // Disabled to isolate pure training-loop throughput -- eval/validation
  // cost doesn't scale with dataset size the way training does, so
  // including it would just add noise to the scaling measurement.
  validation_enabled: false,
  validation_split: 0.1,

  online_eval_enabled: false,
  online_eval_every_n_epochs: 1,
  online_eval_datasets: "lipo",
  online_eval_fixed_k: 21,
  online_eval_top_k_checkpoints: 5,
}
