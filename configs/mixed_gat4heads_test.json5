{
  // ---------------------------------------------------------------------------
  // Mixed-augmentation + multi-head GAT test: local_views=2, one view built
  // via functional_group_k_hop (k_hops=2), the other via
  // functional_group_masking (node_mask_ratio=0.60) -- via the new
  // local_view_modes override in GraphAugmentation/ModelConfig (see
  // datahandling/graph_augmentation.py, model/config.py). Previously only
  // discussed conceptually this session; this is the first run to actually
  // use it. Combined with gat_heads=4 (hidden_dim=1024, divides evenly,
  // 256 per head).
  //
  // Rationale for mixing: a single fixed augmentation strategy gives the
  // network one consistent "recipe" that could support a shortcut; mixing
  // strategies means a trick that works for a k-hop subgraph (spatially
  // contiguous fragment) likely doesn't transfer to a masked view (scattered
  // zeroed-out subset of the same full graph), removing any single
  // consistent shortcut to lean on across all local views.
  //
  // New model, trained from scratch.
  // ---------------------------------------------------------------------------
  name: "MIXED_GAT4HEADS_TEST_60EP",

  head_type: "dino",
  encoder_type: "GAT",
  global_pooling: "add",

  // ---------------------------------------------------------------------------
  // Data loading -- original 24-feature production dataset, staged to its
  // own scratch path by run_mixed_gat4heads_test.sbatch.
  // ---------------------------------------------------------------------------
  data_path: "data/zinc/zinc_9M_data",
  use_precomputed: true,
  precomputed_data_path: "/scratch/local/precomputed_9M_data_mixed4test",
  cache_data_in_memory: false,
  precomputed_cache_in_memory: false,
  precomputed_max_cached_shards: 3,
  explicit_hydrogens: true,
  encode_hydrogen_count: false,

  // ---------------------------------------------------------------------------
  // Augmentation -- mixed: view 0 = functional_group_k_hop (k_hops=2),
  // view 1 = functional_group_masking (node_mask_ratio=0.60,
  // feature_mask_ratio=0, matching the masking60pct_fix_test.json5
  // baseline's own values). local_augmentation_mode is set but unused/
  // overridden by local_view_modes -- kept as a valid, documented fallback
  // value only.
  // ---------------------------------------------------------------------------
  local_views: 2,
  local_augmentation_mode: "functional_group_k_hop",
  local_view_modes: ["functional_group_k_hop", "functional_group_masking"],
  k_hops: 2,
  node_mask_ratio: 0.60,
  feature_mask_ratio: 0,
  use_batched_mask_collate: false,

  // ---------------------------------------------------------------------------
  // Runtime and logging
  // ---------------------------------------------------------------------------
  seed: 1,
  device: "cuda",
  num_workers: 6,
  loader_debug: false,
  profile_timing: true,
  profile_log_every_n_batches: 200,

  // ---------------------------------------------------------------------------
  // Model dimensions -- 24 features, hidden_dim=1024 (divides evenly by 4).
  // ---------------------------------------------------------------------------
  num_features: 24,
  edge_features: 12,
  hidden_dim: 1024,
  num_layers: 3,
  gat_heads: 4,
  dropout: 0.0,
  epsilon: 0.0,
  projection_hidden_dim: 1024,
  projection_bottleneck_dim: 1024,
  projection_output_dim: 1024,
  projection_layers: 2,

  // ---------------------------------------------------------------------------
  // Training and optimization -- identical to weight_decay_fix_test.json5
  // ---------------------------------------------------------------------------
  num_epochs: 60,

  batch_size: 128,

  auto_scale_lr: false,
  learning_rate: 0.000025,
  use_data_parallel: false,
  lr_scale_base: 0.00000625,
  lr_scale_reference_batch_size: 256,
  weight_decay: 0.04,
  weight_decay_start: 0.04,
  weight_decay_end: 0.2,

  teacher_temp: 0.07,
  teacher_temp_final: 0.01,
  teacher_temp_warmup_epochs: 20,

  student_temp: 0.1,
  teacher_momentum: 0.99,
  center_momentum: 0.9,
  sync_teacher_batchnorm_buffers: true,
  warmup_epochs: 20,
  final_learning_rate: 0.00001,

  validation_enabled: true,
  validation_split: 0.1,

  online_eval_enabled: false,
  online_eval_every_n_epochs: 1,
  online_eval_datasets: "lipo",
  online_eval_fixed_k: 21,
  online_eval_top_k_checkpoints: 5,
}
